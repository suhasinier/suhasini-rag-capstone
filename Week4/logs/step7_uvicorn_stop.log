STEP:        step7_uvicorn_stop
DESCRIPTION: Stop uvicorn cleanly
EXPECTED RC: 0
TIMESTAMP:   2026-09-24T15:26:06+00:00
COMMAND:
    if [ -f '/voc/work/W4_package/logs/_uvicorn.pid' ]; then
            pid=$(cat '/voc/work/W4_package/logs/_uvicorn.pid')
            echo "stopping uvicorn, pid=$pid"
            kill $pid 2>/dev/null
            sleep 1
            kill -0 $pid 2>/dev/null && kill -9 $pid 2>/dev/null
            rm -f '/voc/work/W4_package/logs/_uvicorn.pid'
            echo 'uvicorn stopped'
        else
            echo 'no pid file'
            exit 1
        fi
